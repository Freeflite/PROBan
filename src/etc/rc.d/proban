#!/bin/sh
#
# PROVIDE: proban
# REQUIRE: LOGIN
# KEYWORD: shutdown
#
# ProBAN progressive-ban engine with a persistent, daemon-supervised service.

. /etc/rc.subr

name="proban"
desc="ProBAN progressive-ban engine"
rcvar="proban_enable"
pidfile="/var/run/${name}.pid"
command="/usr/sbin/daemon"
proban_supervisor="/usr/local/opnsense/scripts/OPNsense/Parabolic/proban_supervise.sh"
command_args="-f -r -S -T proban -P ${pidfile} /bin/sh ${proban_supervisor}"

load_rc_config $name
: ${proban_enable:="NO"}

run_rc_command "$1"
